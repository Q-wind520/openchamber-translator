{
  "name": "openchamber-translation",
  "version": "0.2.0",
  "private": true,
  "description": "仅保留全文翻译的 OpenChamber 侧栏扩展，使用 OpenChamber 已配置的 Small Model，无需额外 API Key。",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.5.1"
    },
    "contributes": {
      "panel": {
        "id": "openchamber-translation",
        "name": "全文翻译",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "capabilities": [
        "model"
      ]
    }
  },
  "dependencies": {
    "@openchamber/sdk": "2.5.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
